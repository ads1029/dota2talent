{
  "name": "dota-talent-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:sync": "bun scripts/sync-patch-notes.ts",
    "data:sync-anchors": "bun scripts/sync-snapshot-anchors.ts",
    "data:sync-current": "bun scripts/sync-current-talents.ts",
    "data:build-anchors": "bun scripts/build-snapshot-anchors.ts",
    "data:snapshots": "bun scripts/build-version-snapshots.ts",
    "data:canonical-current": "bun scripts/canonicalize-current-snapshot.ts",
    "data:web": "bun scripts/build-web-dataset.ts",
    "data:build": "bun scripts/build-talent-events.ts",
    "data:bootstrap": "bun scripts/parse-700-talents.ts",
    "data:early": "bun scripts/parse-early-patches.ts",
    "data:translate-early": "bun scripts/translate-early-events.ts",
    "data:translate-labels": "bun scripts/translate-talent-labels.ts",
    "data:assemble": "bun scripts/assemble-talent-history.ts",
    "data:validate": "bun scripts/validate-talent-data.ts",
    "data:compile": "bun run data:bootstrap && bun run data:early && bun run data:build && bun run data:assemble && bun run data:build-anchors && bun run data:snapshots && bun run data:canonical-current && bun run data:web && bun run data:validate",
    "data:import": "bun run data:sync && bun run data:sync-anchors && bun run data:sync-current && bun run data:compile"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "latest",
    "vitest": "latest"
  }
}
